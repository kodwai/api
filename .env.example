# Database (Turso / libSQL)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Encryption (32-byte hex key for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Resend (email)
RESEND_API_KEY=re_your_resend_api_key

# Scoring (uses the session's API key, no separate key needed)
SCORING_MODEL=claude-sonnet-4-6

# Free tier — developers get FREE_SUBMISSION_LIMIT submissions scored with this
# platform key before they must connect their own Anthropic key. Leave
# PLATFORM_ANTHROPIC_API_KEY empty to turn the free tier off.
PLATFORM_ANTHROPIC_API_KEY=
FREE_SUBMISSION_LIMIT=3

# CORS
CORS_ORIGINS=http://localhost:3000

# URLs
APP_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000

# Sentry (leave SENTRY_DSN empty to disable error reporting locally)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Growth: lifecycle email, automation, attribution. All sending is also gated by the
# lifecycle_emails / feedback_ack_emails feature flags (both OFF by default).
# Commented lines show the built-in defaults; uncomment only to override.
# Inbox that lifecycle/feedback replies go to (real lifecycle sends refuse while empty)
EMAIL_REPLY_TO=
# Random secret for one-click unsubscribe tokens, e.g. `openssl rand -hex 32`
UNSUBSCRIBE_SECRET=
# Resend dashboard > Webhooks signing secret (whsec_...)
RESEND_WEBHOOK_SECRET=
# Postal address for the lifecycle email footer
COMPANY_POSTAL_ADDRESS=
# Comma-separated internal emails excluded from lifecycle sends and growth stats
INTERNAL_EMAILS=
# Server-side PostHog capture (project key phc_...; empty = off)
POSTHOG_PROJECT_KEY=
# EMAIL_FROM_LIFECYCLE='"Hakan from Kodwai" <hi@updates.kodwai.com>'
# EMAIL_FROM_TRANSACTIONAL='Kodwai <noreply@kodwai.com>'
# LIFECYCLE_STARTER_CHALLENGE_SLUG=bookshelf-rest-api
